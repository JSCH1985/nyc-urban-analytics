{
  "properties": {
    "parameters": {
      "months": {
        "type": "string",
        "defaultValue": ""
      }
    },
    "activities": [
      {
        "name": "For each month",
        "type": "ForEach",
        "dependsOn": [],
        "typeProperties": {
          "items": {
            "value": "@if(empty(pipeline().parameters.months), createArray(formatDateTime(addToTime(utcNow(), -1, 'Month'), 'yyyy-MM'), formatDateTime(addToTime(utcNow(), -2, 'Month'), 'yyyy-MM'), formatDateTime(addToTime(utcNow(), -3, 'Month'), 'yyyy-MM')), split(pipeline().parameters.months, ';'))",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 4,
          "activities": [
            {
              "name": "Copy month",
              "type": "Copy",
              "dependsOn": [],
              "policy": {
                "timeout": "0.02:00:00",
                "retry": 1,
                "retryIntervalInSeconds": 60,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "BinarySource",
                  "storeSettings": {
                    "type": "HttpReadSettings",
                    "requestMethod": "GET"
                  },
                  "datasetSettings": {
                    "annotations": [],
                    "type": "Binary",
                    "typeProperties": {
                      "location": {
                        "type": "HttpServerLocation",
                        "relativeUrl": {
                          "value": "@concat('trip-data/yellow_tripdata_', item(), '.parquet')",
                          "type": "Expression"
                        }
                      }
                    },
                    "externalReferences": {
                      "connection": "{{CONNECTION_ID}}"
                    }
                  }
                },
                "sink": {
                  "type": "BinarySink",
                  "storeSettings": {
                    "type": "LakehouseWriteSettings"
                  },
                  "datasetSettings": {
                    "annotations": [],
                    "linkedService": {
                      "name": "lh_bronze",
                      "properties": {
                        "annotations": [],
                        "type": "Lakehouse",
                        "typeProperties": {
                          "workspaceId": "{{WORKSPACE_ID}}",
                          "artifactId": "{{LAKEHOUSE_ID}}",
                          "rootFolder": "Files"
                        }
                      }
                    },
                    "type": "Binary",
                    "typeProperties": {
                      "location": {
                        "type": "LakehouseLocation",
                        "folderPath": "taxi/yellow",
                        "fileName": {
                          "value": "@concat('yellow_tripdata_', item(), '.parquet')",
                          "type": "Expression"
                        }
                      }
                    }
                  }
                },
                "enableStaging": false
              }
            },
            {
              "name": "Not published yet",
              "type": "IfCondition",
              "dependsOn": [
                {
                  "activity": "Copy month",
                  "dependencyConditions": [
                    "Failed"
                  ]
                }
              ],
              "typeProperties": {
                "expression": {
                  "value": "@or(contains(activity('Copy month').error.message, '403'), contains(activity('Copy month').error.message, '404'))",
                  "type": "Expression"
                },
                "ifTrueActivities": [],
                "ifFalseActivities": [
                  {
                    "name": "Copy failed",
                    "type": "Fail",
                    "dependsOn": [],
                    "typeProperties": {
                      "message": {
                        "value": "@activity('Copy month').error.message",
                        "type": "Expression"
                      },
                      "errorCode": {
                        "value": "@activity('Copy month').error.errorCode",
                        "type": "Expression"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "name": "For each zone file",
        "type": "ForEach",
        "dependsOn": [],
        "typeProperties": {
          "items": {
            "value": "@createArray('taxi_zone_lookup.csv', 'taxi_zones.zip')",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "Copy zone file",
              "type": "Copy",
              "dependsOn": [],
              "policy": {
                "timeout": "0.00:30:00",
                "retry": 1,
                "retryIntervalInSeconds": 60,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "BinarySource",
                  "storeSettings": {
                    "type": "HttpReadSettings",
                    "requestMethod": "GET"
                  },
                  "datasetSettings": {
                    "annotations": [],
                    "type": "Binary",
                    "typeProperties": {
                      "location": {
                        "type": "HttpServerLocation",
                        "relativeUrl": {
                          "value": "@concat('misc/', item())",
                          "type": "Expression"
                        }
                      }
                    },
                    "externalReferences": {
                      "connection": "{{CONNECTION_ID}}"
                    }
                  }
                },
                "sink": {
                  "type": "BinarySink",
                  "storeSettings": {
                    "type": "LakehouseWriteSettings"
                  },
                  "datasetSettings": {
                    "annotations": [],
                    "linkedService": {
                      "name": "lh_bronze",
                      "properties": {
                        "annotations": [],
                        "type": "Lakehouse",
                        "typeProperties": {
                          "workspaceId": "{{WORKSPACE_ID}}",
                          "artifactId": "{{LAKEHOUSE_ID}}",
                          "rootFolder": "Files"
                        }
                      }
                    },
                    "type": "Binary",
                    "typeProperties": {
                      "location": {
                        "type": "LakehouseLocation",
                        "folderPath": "taxi/zones",
                        "fileName": {
                          "value": "@item()",
                          "type": "Expression"
                        }
                      }
                    }
                  }
                },
                "enableStaging": false
              }
            }
          ]
        }
      }
    ]
  }
}
