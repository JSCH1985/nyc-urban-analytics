table FactAirQualityHourly

	column date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column hour
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: hour

	column location_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: location_id

	column parameter
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: parameter

	column zone_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: zone_id

	column unit
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: unit

	column reading_count
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: readings

	column value_sum
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: value_sum

	measure 'Hourly PM2.5 ug/m3' = DIVIDE(CALCULATE(SUM(FactAirQualityHourly[value_sum]), FactAirQualityHourly[parameter] = "pm25"), CALCULATE(SUM(FactAirQualityHourly[reading_count]), FactAirQualityHourly[parameter] = "pm25"))
		formatString: 0.0

	measure 'Hourly NO2 ppb' = DIVIDE(CALCULATE(SUM(FactAirQualityHourly[value_sum]), FactAirQualityHourly[parameter] = "no2"), CALCULATE(SUM(FactAirQualityHourly[reading_count]), FactAirQualityHourly[parameter] = "no2"))
		formatString: 0.0

	measure 'Hourly O3 ppb' = DIVIDE(CALCULATE(SUM(FactAirQualityHourly[value_sum]), FactAirQualityHourly[parameter] = "o3"), CALCULATE(SUM(FactAirQualityHourly[reading_count]), FactAirQualityHourly[parameter] = "o3"))
		formatString: 0.0

	partition FactAirQualityHourly = entity
		mode: directLake
		source
			entityName: FactAirQualityHourly
			schemaName: dbo
			expressionSource: DatabaseQuery
