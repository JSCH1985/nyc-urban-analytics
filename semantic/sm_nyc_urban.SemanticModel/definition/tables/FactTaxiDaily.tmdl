table FactTaxiDaily

	column date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column zone_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: zone_id

	column trip_count
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: trips

	column passenger_count
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: passengers

	column distance_miles
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: distance_miles

	column duration_minutes
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: duration_minutes

	column fare_usd
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: fare_usd

	column tip_usd
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: tip_usd

	column total_usd
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: total_usd

	measure Trips = SUM(FactTaxiDaily[trip_count])
		formatString: #,0

	measure Passengers = SUM(FactTaxiDaily[passenger_count])
		formatString: #,0

	measure 'Revenue USD' = SUM(FactTaxiDaily[total_usd])
		formatString: #,0.00

	measure 'Revenue EUR' = SUMX(VALUES(DimDate[date_key]), DIVIDE(CALCULATE(SUM(FactTaxiDaily[total_usd])), CALCULATE(MAX(DimFX[USD per EUR]))))
		formatString: #,0.00

	measure 'Fare USD' = SUM(FactTaxiDaily[fare_usd])
		formatString: #,0

	measure 'Tips USD' = SUM(FactTaxiDaily[tip_usd])
		formatString: #,0

	measure 'Distance Miles' = SUM(FactTaxiDaily[distance_miles])
		formatString: #,0

	measure 'Avg Trip Miles' = DIVIDE([Distance Miles], [Trips])
		formatString: 0.00

	measure 'Avg Trip Minutes' = DIVIDE(SUM(FactTaxiDaily[duration_minutes]), [Trips])
		formatString: 0.0

	measure 'Avg Fare USD' = DIVIDE([Fare USD], [Trips])
		formatString: 0.00

	measure 'Tip Rate' = DIVIDE([Tips USD], [Fare USD])
		formatString: 0.0%

	measure 'Taxi Revenue Share of GDP' = DIVIDE(CONVERT([Revenue USD], DOUBLE), [GDP USD])
		formatString: 0.0000%

	partition FactTaxiDaily = entity
		mode: directLake
		source
			entityName: FactTaxiDaily
			schemaName: dbo
			expressionSource: DatabaseQuery
