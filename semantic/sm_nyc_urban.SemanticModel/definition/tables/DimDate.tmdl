table DimDate
	dataCategory: Time

	column date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: calendar_date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column Quarter
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: quarter

	column Month
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: month

	column 'Month Name'
		dataType: string
		summarizeBy: none
		sortByColumn: Month
		sourceColumn: month_name

	column Day
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: day

	column Weekday
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: weekday

	column 'Weekday Name'
		dataType: string
		summarizeBy: none
		sortByColumn: Weekday
		sourceColumn: weekday_name

	column 'Is Weekend'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_weekend

	partition DimDate = entity
		mode: directLake
		source
			entityName: DimDate
			schemaName: dbo
			expressionSource: DatabaseQuery
