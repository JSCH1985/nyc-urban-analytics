table FactTaxiHourly

	column date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column hour
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: hour

	column zone_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: zone_id

	column trip_count
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: trips

	column distance_miles
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: distance_miles

	column duration_minutes
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: duration_minutes

	column total_usd
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: total_usd

	column speed_distance_miles
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: speed_distance_miles

	column speed_duration_minutes
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: speed_duration_minutes

	measure 'Hourly Trips' = SUM(FactTaxiHourly[trip_count])
		formatString: #,0

	measure 'Avg Speed mph' = DIVIDE(SUM(FactTaxiHourly[speed_distance_miles]), SUM(FactTaxiHourly[speed_duration_minutes]) / 60)
		formatString: 0.0

	partition FactTaxiHourly = entity
		mode: directLake
		source
			entityName: FactTaxiHourly
			schemaName: dbo
			expressionSource: DatabaseQuery
