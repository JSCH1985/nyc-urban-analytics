{
  "uid": "nyc-weather",
  "title": "NYC weather, taxis and air quality",
  "tags": [
    "nyc-urban-analytics",
    "weather"
  ],
  "timezone": "America/New_York",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-2y",
    "to": "now"
  },
  "refresh": "",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "borough",
        "label": "Borough",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "query": "SELECT DISTINCT borough FROM weather_hourly ORDER BY 1",
        "definition": "SELECT DISTINCT borough FROM weather_hourly ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Temperature, latest hour",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(time, 1h), avg(temperature_c) AS \"Temperature\"\nFROM weather_hourly\nWHERE $__timeFilter(time) AND borough IN ($borough)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hours with precipitation",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT avg(CASE WHEN precipitation_mm >= 0.1 THEN 1.0 ELSE 0.0 END) AS \"Wet hours\"\nFROM weather_hourly\nWHERE $__timeFilter(time) AND borough IN ($borough)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Taxi trips",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT sum(trips) AS \"Trips\"\nFROM weather_hourly\nWHERE $__timeFilter(time) AND borough IN ($borough)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Last successful sync",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT extract(epoch FROM max(finished_at)) * 1000 AS \"Last sync\"\nFROM sync_run\nWHERE status = 'succeeded'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Temperature by borough",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(time, $__interval), borough AS metric, avg(temperature_c) AS value\nFROM weather_hourly\nWHERE $__timeFilter(time) AND borough IN ($borough)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Taxi trips and precipitation",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(time, $__interval), sum(trips) AS \"Trips\", sum(precipitation_mm) / count(DISTINCT borough) AS \"Precipitation\"\nFROM weather_hourly\nWHERE $__timeFilter(time) AND borough IN ($borough)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Precipitation"
            },
            "properties": [
              {
                "id": "unit",
                "value": "lengthmm"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.drawStyle",
                "value": "bars"
              },
              {
                "id": "custom.fillOpacity",
                "value": 60
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Trips per borough-hour by weather condition",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT weather_condition AS \"Condition\", avg(trips) AS \"Trips per hour\"\nFROM weather_hourly\nWHERE $__timeFilter(time) AND borough IN ($borough) AND trips IS NOT NULL\nGROUP BY weather_condition, weather_condition_order\nORDER BY weather_condition_order"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Average taxi speed by precipitation",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH banded AS (\n  SELECT CASE WHEN precipitation_mm < 0.1 THEN 1 WHEN precipitation_mm < 1 THEN 2 WHEN precipitation_mm < 4 THEN 3 ELSE 4 END AS band,\n         speed_distance_miles, speed_duration_minutes\n  FROM weather_hourly\n  WHERE $__timeFilter(time) AND borough IN ($borough) AND trips IS NOT NULL\n)\nSELECT (ARRAY['Dry', 'Under 1 mm', '1-4 mm', '4 mm or more'])[band] AS \"Precipitation per hour\",\n       sum(speed_distance_miles) / nullif(sum(speed_duration_minutes), 0) * 60 AS \"Average speed\"\nFROM banded\nGROUP BY band\nORDER BY band"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocitymph"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "PM2.5 by wind speed",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH banded AS (\n  SELECT CASE WHEN wind_speed_kmh < 10 THEN 1 WHEN wind_speed_kmh < 20 THEN 2 WHEN wind_speed_kmh < 30 THEN 3 ELSE 4 END AS band,\n         pm25_sum, pm25_readings\n  FROM weather_hourly\n  WHERE $__timeFilter(time) AND borough IN ($borough) AND pm25_readings > 0\n)\nSELECT (ARRAY['Under 10 km/h', '10-20 km/h', '20-30 km/h', '30 km/h or more'])[band] AS \"Wind speed\",\n       sum(pm25_sum) / sum(pm25_readings) AS \"PM2.5\"\nFROM banded\nGROUP BY band\nORDER BY band"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "con\u03bcgm3"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Trips per borough-hour by temperature",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH banded AS (\n  SELECT CASE WHEN temperature_c < 0 THEN 1 WHEN temperature_c < 10 THEN 2 WHEN temperature_c < 20 THEN 3 WHEN temperature_c < 30 THEN 4 ELSE 5 END AS band, trips\n  FROM weather_hourly\n  WHERE $__timeFilter(time) AND borough IN ($borough) AND trips IS NOT NULL\n)\nSELECT (ARRAY['Below 0 C', '0-10 C', '10-20 C', '20-30 C', '30 C or more'])[band] AS \"Temperature\", avg(trips) AS \"Trips per hour\"\nFROM banded\nGROUP BY band\nORDER BY band"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Sync runs (New York time)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT run_id AS \"Run\", started_at AS \"Started\", finished_at AS \"Finished\", to_char(window_from, 'YYYY-MM-DD') AS \"From\", rows_read AS \"Rows copied\",\n       source_count AS \"wh_gold rows\", target_count AS \"TimescaleDB rows\", status AS \"Status\"\nFROM sync_run\nORDER BY run_id DESC\nLIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
